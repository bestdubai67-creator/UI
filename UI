    -- ========================================================================
    function Window:AddTabSystem(page)
        local TabContainer = Create("Frame", {
            Parent = page.Content,
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = 0.4,
            LayoutOrder = #page.Elements + 1,
        })
        AddCorner(TabContainer, 11)
        AddStroke(TabContainer, Theme.Border, 1, 0.5)
        
        local TabList = Create("Frame", {
            Parent = TabContainer,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
        })
        
        Create("UIListLayout", {
            Parent = TabList,
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        })
        AddPadding(TabList, 8)
        
        local TabSystem = {
            Container = TabContainer,
            List = TabList,
            Tabs = {},
            CurrentTab = nil,
        }
        
        function TabSystem:AddTab(name, callback)
            local TabButton = Create("TextButton", {
                Parent = self.List,
                Size = UDim2.new(0, 120, 1, -16),
                BackgroundColor3 = Theme.Surface,
                BackgroundTransparency = 0.6,
                Text = "",
                AutoButtonColor = false,
            })
            AddCorner(TabButton, 9)
            
            local TabGradient = Create("Frame", {
                Parent = TabButton,
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Theme.Primary,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
            })
            AddCorner(TabGradient, 9)
            AddGradient(TabGradient, ColorSequence.new(Theme.Primary, Theme.Accent), 45)
            
            local TabLabel = Create("TextLabel", {
                Parent = TabButton,
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = name,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
            })
            
            local TabIndicator = Create("Frame", {
                Parent = TabButton,
                Position = UDim2.new(0.5, 0, 1, -3),
                AnchorPoint = Vector2.new(0.5, 0),
                Size = UDim2.new(0, 0, 0, 3),
                BackgroundColor3 = Theme.Primary,
                BorderSizePixel = 0,
            })
            AddCorner(TabIndicator, 10)
            
            local Tab = {
                Button = TabButton,
                Label = TabLabel,
                Gradient = TabGradient,
                Indicator = TabIndicator,
                Name = name,
                Callback = callback,
            }
            
            TabButton.MouseButton1Click:Connect(function()
                self:SelectTab(Tab)
                PlaySound(Sounds.Nav, 0.25)
            end)
            
            TabButton.MouseEnter:Connect(function()
                if self.CurrentTab ~= Tab then
                    PlaySound(Sounds.Hover, 0.08)
                    Tween(TabButton, 0.2, {BackgroundTransparency = 0.3}, Enum.EasingStyle.Quart)
                    Tween(TabGradient, 0.2, {BackgroundTransparency = 0.92}, Enum.EasingStyle.Quart)
                    Tween(TabLabel, 0.2, {TextSize = 14}, Enum.EasingStyle.Quart)
                end
            end)
            
            TabButton.MouseLeave:Connect(function()
                if self.CurrentTab ~= Tab then
                    Tween(TabButton, 0.2, {BackgroundTransparency = 0.6}, Enum.EasingStyle.Quart)
                    Tween(TabGradient, 0.2, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
                    Tween(TabLabel, 0.2, {TextSize = 13}, Enum.EasingStyle.Quart)
                end
            end)
            
            table.insert(self.Tabs, Tab)
            
            if #self.Tabs == 1 then
                self:SelectTab(Tab)
            end
            
            return Tab
        end
        
        function TabSystem:SelectTab(tab)
            for _, t in ipairs(self.Tabs) do
                Tween(t.Button, 0.3, {BackgroundTransparency = 0.6}, Enum.EasingStyle.Quart)
                Tween(t.Gradient, 0.3, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
                Tween(t.Label, 0.3, {
                    TextColor3 = Theme.Text,
                    TextSize = 13
                }, Enum.EasingStyle.Quart)
                t.Label.Font = Enum.Font.Gotham
                Tween(t.Indicator, 0.3, {Size = UDim2.new(0, 0, 0, 3)}, Enum.EasingStyle.Quart)
            end
            
            Tween(tab.Button, 0.3, {BackgroundTransparency = 0.1}, Enum.EasingStyle.Quart)
            Tween(tab.Gradient, 0.3, {BackgroundTransparency = 0.88}, Enum.EasingStyle.Quart)
            Tween(tab.Label, 0.3, {
                TextColor3 = Theme.Primary,
                TextSize = 14
            }, Enum.EasingStyle.Quart)
            tab.Label.Font = Enum.Font.GothamBold
            Tween(tab.Indicator, 0.4, {Size = UDim2.new(0.7, 0, 0, 3)}, Enum.EasingStyle.Back)
            
            self.CurrentTab = tab
            
            if tab.Callback then
                tab.Callback()
            end
        end
        
        table.insert(page.Elements, TabContainer)
        return TabSystem
    end
    
