        })
        
        local stats = {}
        
        local StatsPanel = {
            Container = Panel,
            Stats = stats,
        }
        
        function StatsPanel:AddStat(label, value, icon)
            local StatRow = Create("Frame", {
                Parent = Panel,
                Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = Theme.Surface,
                BackgroundTransparency = 0.5,
                LayoutOrder = #stats + 1,
            })
            AddCorner(StatRow, 8)
            
            if icon then
                local Icon = Create("ImageLabel", {
                    Parent = StatRow,
                    Position = UDim2.new(0, 10, 0.5, 0),
                    AnchorPoint = Vector2.new(0, 0.5),
                    Size = UDim2.fromOffset(18, 18),
                    BackgroundTransparency = 1,
                    Image = icon,
                    ImageColor3 = Theme.Primary,
                })
            end
            
            local StatLabel = Create("TextLabel", {
                Parent = StatRow,
                Position = UDim2.new(0, icon and 36 or 12, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0.5, -(icon and 48 or 24), 0, 18),
                BackgroundTransparency = 1,
                Text = label,
                TextColor3 = Theme.TextSecondary,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            
            local StatValue = Create("TextLabel", {
                Parent = StatRow,
                Position = UDim2.new(1, -12, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                Size = UDim2.new(0.5, -12, 0, 18),
                BackgroundTransparency = 1,
                Text = tostring(value),
                TextColor3 = Theme.Primary,
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Right,
            })
            
            StatRow.MouseEnter:Connect(function()
                Tween(StatRow, 0.2, {BackgroundTransparency = 0.3}, Enum.EasingStyle.Quart)
            end)
            
            StatRow.MouseLeave:Connect(function()
                Tween(StatRow, 0.2, {BackgroundTransparency = 0.5}, Enum.EasingStyle.Quart)
            end)
            
            local stat = {
                Row = StatRow,
                ValueLabel = StatValue,
            }
            
            function stat:Update(newValue)
                StatValue.Text = tostring(newValue)
                Tween(StatValue, 0.15, {TextSize = 16}, Enum.EasingStyle.Quart)
                task.wait(0.15)
                Tween(StatValue, 0.15, {TextSize = 14}, Enum.EasingStyle.Quart)
            end
            
            table.insert(stats, stat)
            return stat
        end
        
        table.insert(page.Elements, Panel)
        return StatsPanel
    end
    
