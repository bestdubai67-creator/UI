    -- ADD RATING (Star rating system)
    -- ========================================================================
    function Window:AddRating(page, text, maxStars, defaultRating, callback)
        maxStars = maxStars or 5
        defaultRating = defaultRating or 0
        
        local Container = Create("Frame", {
            Parent = page.Content,
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = 0.3,
            LayoutOrder = #page.Elements + 1,
        })
        AddCorner(Container, 11)
        AddStroke(Container, Theme.Border, 1, 0.5)
        
        local Label = Create("TextLabel", {
            Parent = Container,
            Position = UDim2.new(0, 18, 0, 12),
            Size = UDim2.new(1, -36, 0, 20),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Theme.Text,
            Font = Enum.Font.Gotham,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        local StarsContainer = Create("Frame", {
            Parent = Container,
            Position = UDim2.new(0, 18, 1, -30),
            Size = UDim2.new(1, -36, 0, 24),
            BackgroundTransparency = 1,
        })
        
        local rating = defaultRating
        local stars = {}
        
        for i = 1, maxStars do
            local Star = Create("TextButton", {
                Parent = StarsContainer,
                Position = UDim2.new(0, (i - 1) * 32, 0, 0),
                Size = UDim2.fromOffset(28, 28),
                BackgroundTransparency = 1,
                Text = i <= rating and "★" or "☆",
                TextColor3 = i <= rating and Theme.Warning or Theme.TextSecondary,
                Font = Enum.Font.GothamBold,
                TextSize = 24,
                AutoButtonColor = false,
            })
            
            stars[i] = Star
            
            Star.MouseButton1Click:Connect(function()
                rating = i
                PlaySound(Sounds.Click, 0.3)
                
                for j = 1, maxStars do
                    local filled = j <= rating
                    stars[j].Text = filled and "★" or "☆"
                    Tween(stars[j], 0.25, {
                        TextColor3 = filled and Theme.Warning or Theme.TextSecondary,
                        Rotation = filled and 360 or 0
                    }, Enum.EasingStyle.Back)
                end
                
                task.wait(0.25)
                for j = 1, maxStars do
                    stars[j].Rotation = 0
                end
                
                if callback then callback(rating) end
            end)
            
            Star.MouseEnter:Connect(function()
                PlaySound(Sounds.Hover, 0.08)
                -- Preview hover effect
                for j = 1, maxStars do
                    local shouldFill = j <= i
                    Tween(stars[j], 0.15, {
                        TextColor3 = shouldFill and Theme.Warning or Theme.TextSecondary,
                        TextSize = shouldFill and 26 or 24
                    }, Enum.EasingStyle.Quart)
                end
            end)
            
            StarsContainer.MouseLeave:Connect(function()
                -- Restore actual rating
                for j = 1, maxStars do
                    local filled = j <= rating
                    Tween(stars[j], 0.15, {
                        TextColor3 = filled and Theme.Warning or Theme.TextSecondary,
                        TextSize = 24
                    }, Enum.EasingStyle.Quart)
                end
            end)
        end
        
        Container.MouseEnter:Connect(function()
            Tween(Container, 0.2, {BackgroundTransparency = 0.15}, Enum.EasingStyle.Quart)
        end)
        
        Container.MouseLeave:Connect(function()
            Tween(Container, 0.2, {BackgroundTransparency = 0.3}, Enum.EasingStyle.Quart)
        end)
        
        table.insert(page.Elements, Container)
        return Container
    end
    
