local function CreateParticleSystem(parent, theme)
    task.spawn(function()
        while parent and parent.Parent do
            local orb = Create("Frame", {
                Parent = parent,
                Size = UDim2.fromOffset(math.random(40, 100), math.random(40, 100)),
                Position = UDim2.new(math.random(0, 100)/100, 0, 1.2, 0),
                BackgroundColor3 = theme.Primary,
                BackgroundTransparency = 0.8,
                BorderSizePixel = 0,
                ZIndex = 0,
            })
            AddCorner(orb, 100)
            
            local orbGradient = AddGradient(orb, 
                ColorSequence.new(theme.Primary, theme.Accent), 
                math.random(0, 360)
            )
            
            -- Rotate gradient
            task.spawn(function()
                while orb.Parent do
                    for i = 0, 360, 3 do
                        if not orb.Parent then break end
                        orbGradient.Rotation = i
                        task.wait(0.05)
                    end
                end
            end)
            
            Tween(orb, math.random(25, 40), {
                Position = UDim2.new(math.random(0, 100)/100, 0, -0.2, 0),
                BackgroundTransparency = 1,
                Rotation = math.random(-360, 360),
                Size = UDim2.fromOffset(math.random(20, 50), math.random(20, 50))
            }, Enum.EasingStyle.Linear)
            
            game:GetService("Debris"):AddItem(orb, 40)
            task.wait(math.random(20, 60)/10)
        end
    end)
end

