            BackgroundColor3 = Theme.Primary,
        })
        AddCorner(ProgressFill, 10)
        AddGradient(ProgressFill, ColorSequence.new(Theme.Primary, Theme.Accent), 90)
        
        -- Animated glow effect
        local ProgressGlow = Create("Frame", {
            Parent = ProgressFill,
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.7,
            BorderSizePixel = 0,
        })
        AddCorner(ProgressGlow, 10)
        
        -- Shimmer animation
        task.spawn(function()
            while ProgressFill and ProgressFill.Parent do
                Tween(ProgressGlow, 0.8, {BackgroundTransparency = 0.4}, Enum.EasingStyle.Sine)
                task.wait(0.8)
                if ProgressFill and ProgressFill.Parent then
                    Tween(ProgressGlow, 0.8, {BackgroundTransparency = 0.7}, Enum.EasingStyle.Sine)
                    task.wait(0.8)
                end
            end
        end)
        
        Container.MouseEnter:Connect(function()
            Tween(Container, 0.2, {BackgroundTransparency = 0.15}, Enum.EasingStyle.Quart)
            Tween(ProgressBG, 0.2, {Size = UDim2.new(1, -32, 0, 12)}, Enum.EasingStyle.Quart)
