                Size = UDim2.new(1, -52, 0, 20),
                BackgroundTransparency = 1,
                Text = option,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            
            local OptionButton = Create("TextButton", {
                Parent = OptionContainer,
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = "",
            })
            
            OptionButton.MouseButton1Click:Connect(function()
                selected[option] = not selected[option]
                
                PlaySound(Sounds.Toggle, 0.3)
                
                if selected[option] then
                    Checkmark.Text = "✓"
                    Tween(Checkmark, 0.25, {TextTransparency = 0}, Enum.EasingStyle.Quart)
                    Tween(Checkbox, 0.25, {BackgroundColor3 = Theme.Primary}, Enum.EasingStyle.Quart)
                    Tween(Checkbox:FindFirstChildOfClass("UIStroke"), 0.25, {
                        Color = Theme.Primary,
                        Transparency = 0.2
                    })
                    Tween(OptionLabel, 0.2, {TextColor3 = Theme.Primary}, Enum.EasingStyle.Quart)
                else
                    Tween(Checkmark, 0.25, {TextTransparency = 1}, Enum.EasingStyle.Quart)
                    Tween(Checkbox, 0.25, {BackgroundColor3 = Theme.Surface}, Enum.EasingStyle.Quart)
                    Tween(Checkbox:FindFirstChildOfClass("UIStroke"), 0.25, {
                        Color = Theme.Border,
                        Transparency = 0.4
                    })
                    Tween(OptionLabel, 0.2, {TextColor3 = Theme.Text}, Enum.EasingStyle.Quart)
                    task.wait(0.2)
                    Checkmark.Text = ""
                end
                
                -- Bounce effect
                Tween(Checkbox, 0.15, {Size = UDim2.fromOffset(24, 24)}, Enum.EasingStyle.Quart)
                task.wait(0.15)
                Tween(Checkbox, 0.2, {Size = UDim2.fromOffset(20, 20)}, Enum.EasingStyle.Back)
                
                if callback then callback(selected) end
            end)
            
            OptionContainer.MouseEnter:Connect(function()
                PlaySound(Sounds.Hover, 0.08)
                Tween(OptionContainer, 0.2, {
                    BackgroundTransparency = 0.4,
                    Size = UDim2.new(1, -32, 0, 32)
                }, Enum.EasingStyle.Quart)
            end)
            
            OptionContainer.MouseLeave:Connect(function()
                Tween(OptionContainer, 0.2, {
                    BackgroundTransparency = 0.6,
                    Size = UDim2.new(1, -36, 0, 32)
                }, Enum.EasingStyle.Quart)
            end)
        end
        
        Container.MouseEnter:Connect(function()
