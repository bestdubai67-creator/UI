    -- ========================================================================
    function Window:AddLoader(page, text)
        local Container = Create("Frame", {
            Parent = page.Content,
            Size = UDim2.new(1, 0, 0, 80),
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = 0.3,
            LayoutOrder = #page.Elements + 1,
        })
        AddCorner(Container, 11)
        AddStroke(Container, Theme.Border, 1, 0.5)
        
        local Label = Create("TextLabel", {
            Parent = Container,
            Position = UDim2.new(0.5, 0, 0, 18),
            AnchorPoint = Vector2.new(0.5, 0),
            Size = UDim2.new(1, -40, 0, 20),
            BackgroundTransparency = 1,
            Text = text or "Loading...",
            TextColor3 = Theme.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
        })
        
        -- Spinner container
        local SpinnerContainer = Create("Frame", {
            Parent = Container,
            Position = UDim2.new(0.5, 0, 1, -42),
            AnchorPoint = Vector2.new(0.5, 0),
            Size = UDim2.fromOffset(32, 32),
            BackgroundTransparency = 1,
        })
        
        -- Create spinner dots
        for i = 1, 8 do
            local angle = (i - 1) * 45
            local rad = math.rad(angle)
            local x = math.sin(rad) * 12
            local y = math.cos(rad) * 12
            
            local Dot = Create("Frame", {
                Parent = SpinnerContainer,
                Position = UDim2.new(0.5, x, 0.5, y),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(6, 6),
                BackgroundColor3 = Theme.Primary,
                BackgroundTransparency = (i - 1) * 0.1,
            })
            AddCorner(Dot, 20)
            
            -- Pulse animation with delay
            task.spawn(function()
                task.wait((i - 1) * 0.08)
                while Dot and Dot.Parent do
                    Tween(Dot, 0.4, {
                        Size = UDim2.fromOffset(8, 8),
                        BackgroundTransparency = 0
                    }, Enum.EasingStyle.Sine)
                    task.wait(0.4)
                    if Dot and Dot.Parent then
                        Tween(Dot, 0.4, {
                            Size = UDim2.fromOffset(6, 6),
                            BackgroundTransparency = 0.5
                        }, Enum.EasingStyle.Sine)
                        task.wait(0.4)
                    end
                end
            end)
        end
        
        -- Rotate animation
        task.spawn(function()
            while SpinnerContainer and SpinnerContainer.Parent do
                for i = 0, 360, 4 do
                    if not SpinnerContainer or not SpinnerContainer.Parent then break end
                    SpinnerContainer.Rotation = i
                    task.wait(0.02)
                end
            end
        end)
        
        local Loader = {
            Container = Container,
            Label = Label,
        }
        
        function Loader:SetText(newText)
            Label.Text = newText
        end
        
        function Loader:Remove()
            Tween(Container, 0.3, {
                Size = UDim2.new(1, 0, 0, 0),
                BackgroundTransparency = 1
            })
            task.wait(0.3)
            Container:Destroy()
        end
        
        table.insert(page.Elements, Container)
        return Loader
    end
    
