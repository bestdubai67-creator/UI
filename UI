local function CreateGridBackground(parent, theme)
    local GridBG = Create("Frame", {
        Name = "GridBG",
        Parent = parent,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 0,
    })
    
    -- Vertical lines
    for i = 0, 25 do
        Create("Frame", {
            Parent = GridBG,
            Size = UDim2.new(0, 1, 1, 0),
            Position = UDim2.fromScale(i/25, 0),
            BackgroundColor3 = theme.Border,
            BackgroundTransparency = 0.85,
            BorderSizePixel = 0,
        })
    end
    
    -- Horizontal lines
    for i = 0, 20 do
        Create("Frame", {
            Parent = GridBG,
            Size = UDim2.new(1, 0, 0, 1),
            Position = UDim2.fromScale(0, i/20),
            BackgroundColor3 = theme.Border,
            BackgroundTransparency = 0.85,
            BorderSizePixel = 0,
        })
    end
    
    return GridBG
end

