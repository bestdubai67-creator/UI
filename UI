                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                })
                AddCorner(OptionButton, 6)
                
                OptionButton.MouseButton1Click:Connect(function()
                    selected = option
                    DropdownButton.Text = "  " .. selected
                    dropdownOpen = false
                    DropdownList.Visible = false
                    Tween(Arrow, 0.2, {Rotation = 0})
                    Tween(DropdownList, 0.2, {Size = UDim2.new(0.5, -20, 0, 0)})
                    
                    if callback then
                        callback(selected)
                    end
                end)
                
                OptionButton.MouseEnter:Connect(function()
                    Tween(OptionButton, 0.1, {BackgroundColor3 = Theme.Hover})
                end)
                
                OptionButton.MouseLeave:Connect(function()
                    Tween(OptionButton, 0.1, {BackgroundColor3 = Theme.Surface})
                end)
            end
            
            table.insert(self.Elements, DropdownContainer)
            
            return {
                Container = DropdownContainer,
                GetSelected = function()
                    return selected
                end,
                SetSelected = function(value)
                    selected = value
                    DropdownButton.Text = "  " .. selected
                end
            }
        end
        
        return Tab
    end
    
    -- ========================================================================
    -- SWITCH TAB FUNCTION
    -- ========================================================================
    
    function Hub:SwitchToTab(tab)
        -- Hide all pages
        for _, page in ipairs(self.Pages) do
            page.PageContainer.Visible = false
            Tween(page.NavButton, 0.2, {BackgroundTransparency = 1})
            Tween(page.NavLabel, 0.2, {TextColor3 = Theme.TextSecondary})
            Tween(page.NavIcon, 0.2, {ImageColor3 = Theme.TextSecondary})
            Tween(page.ActiveIndicator, 0.2, {Size = UDim2.new(0, 0, 0, 24)})
        end
        
        -- Show selected page
        tab.PageContainer.Visible = true
        self.CurrentPage = tab
        
        Tween(tab.NavButton, 0.2, {BackgroundTransparency = 0.7})
        Tween(tab.NavLabel, 0.2, {TextColor3 = Theme.Text})
        Tween(tab.NavIcon, 0.2, {ImageColor3 = Theme.Primary})
        Tween(tab.ActiveIndicator, 0.2, {Size = UDim2.new(0, 3, 0, 24)})
    end
    
    -- ========================================================================
    -- NOTIFICATION SYSTEM
    -- ========================================================================
    
    function Hub:Notify(config)
        local title = config.Title or "Notification"
        local message = config.Message or ""
        local duration = config.Duration or 3
        local type = config.Type or "info" -- info, success, warning, error
        
        local typeColors = {
            info = Theme.Primary,
            success = Theme.Success,
            warning = Theme.Warning,
            error = Theme.Error,
        }
        
        local color = typeColors[type] or Theme.Primary
        
        local NotifContainer = Create("Frame", {
            Parent = ScreenGui,
            Position = UDim2.new(1, 20, 0, 100),
            Size = UDim2.new(0, 320, 0, 0),
            BackgroundColor3 = Theme.Card,
            ZIndex = 10000,
        })
        AddCorner(NotifContainer, 12)
        AddStroke(NotifContainer, color, 2, 0)
        
        local Accent = Create("Frame", {
            Parent = NotifContainer,
            Size = UDim2.new(0, 4, 1, 0),
            BackgroundColor3 = color,
        })
        AddCorner(Accent, 12)
        
        local TitleLabel = Create("TextLabel", {
            Parent = NotifContainer,
            Position = UDim2.new(0, 20, 0, 12),
            Size = UDim2.new(1, -30, 0, 20),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Theme.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        local MessageLabel = Create("TextLabel", {
            Parent = NotifContainer,
            Position = UDim2.new(0, 20, 0, 35),
            Size = UDim2.new(1, -30, 1, -45),
            BackgroundTransparency = 1,
            Text = message,
            TextColor3 = Theme.TextSecondary,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
        })
        
        -- Calculate height based on text
        local textHeight = TextService:GetTextSize(message, 12, Enum.Font.Gotham, Vector2.new(280, 1000)).Y
        local totalHeight = math.max(70, textHeight + 50)
        
        -- Animate in
        Tween(NotifContainer, 0.4, {
            Position = UDim2.new(1, -330, 0, 100),
            Size = UDim2.new(0, 320, 0, totalHeight)
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        
        -- Auto dismiss
        task.delay(duration, function()
            Tween(NotifContainer, 0.3, {
                Position = UDim2.new(1, 20, 0, 100),
                Size = UDim2.new(0, 320, 0, 0)
            }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            
            task.wait(0.3)
            NotifContainer:Destroy()
        end)
    end
    
