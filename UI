            Parent = ProgressBG,
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = typeData.Color,
            BorderSizePixel = 0,
        })
        AddCorner(ProgressFill, 10)
        
        local textHeight = TextService:GetTextSize(message, 13, Enum.Font.Gotham, Vector2.new(250, 1000)).Y
        local height = math.max(90, textHeight + 60)
        
        Tween(Notif, 0.45, {
            Position = UDim2.new(1, -350, 0, 90),
            Size = UDim2.new(0, 340, 0, height)
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        
        task.spawn(function()
            for i = 1, 4 do
                Tween(IconCircle, 0.35, {Size = UDim2.fromOffset(48, 48)}, Enum.EasingStyle.Sine)
                task.wait(0.35)
                Tween(IconCircle, 0.35, {Size = UDim2.fromOffset(44, 44)}, Enum.EasingStyle.Sine)
                task.wait(0.35)
            end
        end)
        
        Tween(ProgressFill, duration, {Size = UDim2.fromScale(0, 1)}, Enum.EasingStyle.Linear)
        
        task.delay(duration, function()
            Tween(Notif, 0.45, {
                Position = UDim2.new(1, 30, 0, 90),
                BackgroundTransparency = 1
            }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            
            for _, v in pairs(Notif:GetDescendants()) do
                if v:IsA("GuiObject") then
                    Tween(v, 0.45, {
                        BackgroundTransparency = 1,
                        TextTransparency = 1,
                        ImageTransparency = 1
                    })
                end
            end
            
            task.wait(0.5)
            Notif:Destroy()
        end)
    end
    
    return Window
end

