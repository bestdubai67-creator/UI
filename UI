                    if NavIcon then
                        Tween(NavIcon, 0.2, {Size = UDim2.fromOffset(22, 22)})
                    end
                    Tween(NavLabel, 0.2, {TextSize = 14})
                end
            end)
            
            table.insert(Window.Pages, Page)
            
            if #Window.Pages == 1 then
                Window:SelectPage(Page)
            end
        end
        
        return Page
    end
    
    -- ========================================================================
    -- SELECT PAGE
    -- ========================================================================
    function Window:SelectPage(page)
        for _, p in ipairs(self.Pages) do
            p.Content.Visible = false
            if p.HoverGlow then
                Tween(p.HoverGlow, 0.3, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
            end
            if p.SelectIndicator then
                Tween(p.SelectIndicator, 0.3, {Size = UDim2.new(0, 0, 0, 26)}, Enum.EasingStyle.Quart)
            end
            if p.Icon then
                Tween(p.Icon, 0.25, {ImageColor3 = Theme.TextSecondary, Size = UDim2.fromOffset(22, 22)})
            end
            if p.Label then
                Tween(p.Label, 0.25, {TextColor3 = Theme.Text, TextSize = 14})
            end
        end
        
        page.Content.Visible = true
        if page.HoverGlow then
            Tween(page.HoverGlow, 0.3, {BackgroundTransparency = 0.8}, Enum.EasingStyle.Quart)
        end
        if page.SelectIndicator then
            Tween(page.SelectIndicator, 0.45, {Size = UDim2.new(0, 4, 0, 26)}, Enum.EasingStyle.Back)
        end
        if page.Icon then
            Tween(page.Icon, 0.3, {ImageColor3 = Theme.Primary, Size = UDim2.fromOffset(24, 24)})
        end
        if page.Label then
            Tween(page.Label, 0.3, {TextColor3 = Theme.Primary, TextSize = 15})
        end
        
        self.CurrentPage = page
    end
    
