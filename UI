        AddShadow(ColorPicker)
        AddBlur(ColorPicker)
        
        -- RGB Sliders
        local sliders = {"R", "G", "B"}
        local rgb = {currentColor.R * 255, currentColor.G * 255, currentColor.B * 255}
        local sliderColors = {
            Color3.fromRGB(255, 80, 80),
            Color3.fromRGB(80, 255, 80),
            Color3.fromRGB(80, 80, 255)
        }
        
        for i, channel in ipairs(sliders) do
            local SliderContainer = Create("Frame", {
                Parent = ColorPicker,
                Position = UDim2.new(0, 16, 0, 16 + (i - 1) * 42),
                Size = UDim2.new(1, -32, 0, 32),
                BackgroundTransparency = 1,
            })
            
            local SliderLabel = Create("TextLabel", {
                Parent = SliderContainer,
                Size = UDim2.new(0, 20, 0, 20),
                BackgroundTransparency = 1,
                Text = channel,
                TextColor3 = sliderColors[i],
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            
            local SliderValue = Create("TextLabel", {
                Parent = SliderContainer,
                Position = UDim2.new(1, 0, 0, 0),
                AnchorPoint = Vector2.new(1, 0),
                Size = UDim2.new(0, 40, 0, 20),
                BackgroundTransparency = 1,
                Text = math.floor(rgb[i]),
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right,
            })
            
            local SliderTrack = Create("Frame", {
                Parent = SliderContainer,
                Position = UDim2.new(0, 30, 0, 26),
                Size = UDim2.new(1, -78, 0, 6),
                BackgroundColor3 = Theme.Card,
                BackgroundTransparency = 0.5,
            })
            AddCorner(SliderTrack, 10)
            
            local SliderFill = Create("Frame", {
                Parent = SliderTrack,
                Size = UDim2.new(rgb[i] / 255, 0, 1, 0),
                BackgroundColor3 = sliderColors[i],
            })
            AddCorner(SliderFill, 10)
            
            local SliderKnob = Create("Frame", {
                Parent = SliderTrack,
                Position = UDim2.new(rgb[i] / 255, 0, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = sliderColors[i],
            })
            AddCorner(SliderKnob, 20)
            AddShadow(SliderKnob)
            
            local dragging = false
            
            local function UpdateSlider(inputPos)
                local pos = math.clamp((inputPos - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                rgb[i] = pos * 255
                SliderValue.Text = math.floor(rgb[i])
                SliderFill.Size = UDim2.new(pos, 0, 1, 0)
                SliderKnob.Position = UDim2.new(pos, 0, 0.5, 0)
                
                currentColor = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
                ColorButton.BackgroundColor3 = currentColor
                
                if callback then callback(currentColor) end
            end
            
            SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    PlaySound(Sounds.Slide, 0.2)
                    UpdateSlider(input.Position.X)
                    Tween(SliderKnob, 0.2, {Size = UDim2.fromOffset(20, 20)}, Enum.EasingStyle.Quart)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(input.Position.X)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    Tween(SliderKnob, 0.2, {Size = UDim2.fromOffset(16, 16)}, Enum.EasingStyle.Quart)
                end
            end)
        end
        
        -- Preset colors
        local PresetLabel = Create("TextLabel", {
            Parent = ColorPicker,
            Position = UDim2.new(0, 16, 0, 142),
