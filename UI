    -- ========================================================================
    -- ADD SLIDER
    -- ========================================================================
    function Window:AddSlider(page, text, min, max, default, callback)
        local Container = Create("Frame", {
            Parent = page.Content,
            Size = UDim2.new(1, 0, 0, 72),
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = 0.3,
            LayoutOrder = #page.Elements + 1,
        })
        AddCorner(Container, 11)
        AddStroke(Container, Theme.Border, 1, 0.5)
        
        local Label = Create("TextLabel", {
            Parent = Container,
            Position = UDim2.new(0, 18, 0, 12),
            Size = UDim2.new(1, -95, 0, 20),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Theme.Text,
            Font = Enum.Font.Gotham,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        local ValueLabel = Create("TextLabel", {
            Parent = Container,
            Position = UDim2.new(1, -22, 0, 12),
            AnchorPoint = Vector2.new(1, 0),
            Size = UDim2.new(0, 70, 0, 20),
            BackgroundTransparency = 1,
            Text = tostring(default or min),
            TextColor3 = Theme.Primary,
            Font = Enum.Font.GothamBold,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Right,
        })
        
        local SliderTrack = Create("Frame", {
            Parent = Container,
            Position = UDim2.new(0, 18, 1, -26),
            Size = UDim2.new(1, -36, 0, 7),
            BackgroundColor3 = Theme.Surface,
        })
        AddCorner(SliderTrack, 10)
        
        local SliderFill = Create("Frame", {
            Parent = SliderTrack,
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = Theme.Primary,
        })
        AddCorner(SliderFill, 10)
        AddGradient(SliderFill, ColorSequence.new(Theme.Primary, Theme.Accent), 90)
        
        local SliderButton = Create("Frame", {
            Parent = SliderTrack,
            Position = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = Theme.Primary,
        })
        AddCorner(SliderButton, 20)
        AddShadow(SliderButton)
        AddGradient(SliderButton, ColorSequence.new(Theme.Primary, Theme.Accent), 45)
        
        local value = default or min
        local dragging = false
        
        local function UpdateSlider(input)
            local pos = math.clamp((input - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * pos)
            ValueLabel.Text = tostring(value)
            SliderFill.Size = UDim2.new(pos, 0, 1, 0)
            SliderButton.Position = UDim2.new(pos, 0, 0.5, 0)
            
            -- Pulse effect on value change
            Tween(ValueLabel, 0.12, {TextSize = 17}, Enum.EasingStyle.Quart)
            task.wait(0.12)
            Tween(ValueLabel, 0.12, {TextSize = 15}, Enum.EasingStyle.Quart)
            
            if callback then callback(value) end
        end
        
        UpdateSlider(SliderTrack.AbsolutePosition.X + (SliderTrack.AbsoluteSize.X * ((value - min) / (max - min))))
        
        SliderTrack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                PlaySound(Sounds.Slide, 0.3)
                UpdateSlider(input.Position.X)
                Tween(SliderButton, 0.2, {Size = UDim2.fromOffset(22, 22)}, Enum.EasingStyle.Quart)
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                UpdateSlider(input.Position.X)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
                Tween(SliderButton, 0.2, {Size = UDim2.fromOffset(18, 18)}, Enum.EasingStyle.Quart)
            end
        end)
        
        SliderButton.MouseEnter:Connect(function()
            if not dragging then
                PlaySound(Sounds.Hover, 0.1)
                Tween(SliderButton, 0.2, {Size = UDim2.fromOffset(20, 20)}, Enum.EasingStyle.Quart)
            end
        end)
        
        SliderButton.MouseLeave:Connect(function()
            if not dragging then
                Tween(SliderButton, 0.2, {Size = UDim2.fromOffset(18, 18)}, Enum.EasingStyle.Quart)
            end
        end)
        
        Container.MouseEnter:Connect(function()
            Tween(Container, 0.2, {BackgroundTransparency = 0.15}, Enum.EasingStyle.Quart)
        end)
        
        Container.MouseLeave:Connect(function()
            Tween(Container, 0.2, {BackgroundTransparency = 0.3}, Enum.EasingStyle.Quart)
        end)
        
        table.insert(page.Elements, Container)
        return Container
    end
    
