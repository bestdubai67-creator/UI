                PlaceholderColor3 = Theme.TextSecondary,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                ClearTextOnFocus = false,
            })
            AddPadding(Input, 8)
            
            Input.FocusLost:Connect(function()
                if callback then callback(Input.Text) end
            end)
            
            table.insert(self.Elements, Container)
            return Input
        end
        
        function Tab:AddDropdown(text, options, default, callback)
            local Container = Create("Frame", {
                Parent = TabContent,
                Size = UDim2.new(1, 0, 0, 45),
                BackgroundColor3 = Theme.Card,
                LayoutOrder = #self.Elements + 1,
                ClipsDescendants = false,
            })
            AddCorner(Container, 8)
            AddStroke(Container, Theme.Border, 1, 0.3)
            
            local Label = Create("TextLabel", {
                Parent = Container,
                Position = UDim2.new(0, 15, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0.4, -20, 0, 20),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            
            local selected = default or options[1] or "None"
            
            local DropButton = Create("TextButton", {
                Parent = Container,
                Position = UDim2.new(0.4, 5, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0.6, -20, 0, 30),
                BackgroundColor3 = Theme.Surface,
                Text = "  " .. selected,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
            })
            AddCorner(DropButton, 6)
            
            local Arrow = Create("TextLabel", {
                Parent = DropButton,
                Position = UDim2.new(1, -8, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                Size = UDim2.fromOffset(20, 20),
                BackgroundTransparency = 1,
                Text = "▼",
                TextColor3 = Theme.TextSecondary,
                Font = Enum.Font.Gotham,
                TextSize = 10,
            })
            
            local DropList = Create("Frame", {
                Parent = Container,
                Position = UDim2.new(0.4, 5, 1, 5),
                Size = UDim2.new(0.6, -20, 0, 0),
                BackgroundColor3 = Theme.Surface,
                Visible = false,
                ZIndex = 100,
            })
            AddCorner(DropList, 8)
            AddStroke(DropList, Theme.Border, 1, 0.3)
            
            Create("UIListLayout", {
                Parent = DropList,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
            })
            AddPadding(DropList, 5)
            
            local dropOpen = false
            
            DropButton.MouseButton1Click:Connect(function()
                dropOpen = not dropOpen
                DropList.Visible = dropOpen
                
                if dropOpen then
                    Tween(Arrow, 0.2, {Rotation = 180})
                    Tween(DropList, 0.2, {Size = UDim2.new(0.6, -20, 0, math.min(#options * 32 + 10, 150))})
                else
                    Tween(Arrow, 0.2, {Rotation = 0})
                    Tween(DropList, 0.2, {Size = UDim2.new(0.6, -20, 0, 0)})
                end
            end)
            
            for _, option in ipairs(options) do
                local OptButton = Create("TextButton", {
                    Parent = DropList,
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = Theme.Surface,
                    Text = "  " .. option,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                })
                AddCorner(OptButton, 6)
                
                OptButton.MouseButton1Click:Connect(function()
                    selected = option
                    DropButton.Text = "  " .. selected
                    dropOpen = false
                    DropList.Visible = false
                    Tween(Arrow, 0.2, {Rotation = 0})
                    Tween(DropList, 0.2, {Size = UDim2.new(0.6, -20, 0, 0)})
                    if callback then callback(selected) end
                end)
                
                OptButton.MouseEnter:Connect(function()
                    Tween(OptButton, 0.1, {BackgroundColor3 = Theme.Hover})
                end)
                
                OptButton.MouseLeave:Connect(function()
                    Tween(OptButton, 0.1, {BackgroundColor3 = Theme.Surface})
                end)
            end
            
            table.insert(self.Elements, Container)
            return Container
        end
        
        return Tab
    end
    
    -- ========================================================================
    -- SELECT TAB
    -- ========================================================================
    
    function Window:SelectTab(tab)
        for _, t in ipairs(self.Tabs) do
            t.Content.Visible = false
            Tween(t.Button, 0.2, {BackgroundTransparency = 1})
            Tween(t.Label, 0.2, {TextColor3 = Theme.TextSecondary})
            Tween(t.Icon, 0.2, {ImageColor3 = Theme.TextSecondary})
        end
        
        tab.Content.Visible = true
        self.CurrentTab = tab
        Tween(tab.Button, 0.2, {BackgroundTransparency = 0})
        Tween(tab.Label, 0.2, {TextColor3 = Theme.Text})
        Tween(tab.Icon, 0.2, {ImageColor3 = Theme.Primary})
    end
    
    -- ========================================================================
    -- NOTIFICATIONS
    -- ========================================================================
    
    function Window:Notify(config)
        local title = config.Title or "Notification"
        local message = config.Message or ""
        local duration = config.Duration or 3
        
        local types = {
            info = Theme.Primary,
            success = Theme.Success,
            warning = Theme.Warning,
            error = Theme.Error,
        }
        local color = types[config.Type] or Theme.Primary
        
        local Notif = Create("Frame", {
            Parent = ScreenGui,
            Position = UDim2.new(1, 20, 0, 80),
            Size = UDim2.new(0, 300, 0, 0),
            BackgroundColor3 = Theme.Card,
            ZIndex = 10000,
        })
        AddCorner(Notif, 10)
        AddStroke(Notif, color, 2, 0)
        
        local Accent = Create("Frame", {
            Parent = Notif,
            Size = UDim2.new(0, 4, 1, 0),
            BackgroundColor3 = color,
        })
        AddCorner(Accent, 10)
        
        local Title = Create("TextLabel", {
            Parent = Notif,
            Position = UDim2.new(0, 15, 0, 10),
            Size = UDim2.new(1, -25, 0, 18),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Theme.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        local Message = Create("TextLabel", {
            Parent = Notif,
            Position = UDim2.new(0, 15, 0, 30),
            Size = UDim2.new(1, -25, 1, -35),
            BackgroundTransparency = 1,
            Text = message,
            TextColor3 = Theme.TextSecondary,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
        })
        
        local textHeight = TextService:GetTextSize(message, 12, Enum.Font.Gotham, Vector2.new(270, 1000)).Y
        local height = math.max(60, textHeight + 45)
        
        Tween(Notif, 0.3, {
            Position = UDim2.new(1, -310, 0, 80),
            Size = UDim2.new(0, 300, 0, height)
        }, Enum.EasingStyle.Back)
        
        task.delay(duration, function()
            Tween(Notif, 0.3, {
                Position = UDim2.new(1, 20, 0, 80),
                Size = UDim2.new(0, 300, 0, 0)
            }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            task.wait(0.3)
            Notif:Destroy()
        end)
    end
    
    -- Toggle UI
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)
    
    return Window
end

return Invincible