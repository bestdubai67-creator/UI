        Container.MouseLeave:Connect(function()
            Tween(Container, 0.2, {BackgroundTransparency = 0.3}, Enum.EasingStyle.Quart)
            Tween(ProgressBG, 0.2, {Size = UDim2.new(1, -36, 0, 10)}, Enum.EasingStyle.Quart)
        end)
        
        local ProgressBar = {
            Container = Container,
            Fill = ProgressFill,
            Label = PercentLabel,
        }
        
        function ProgressBar:SetValue(newValue)
            newValue = math.clamp(newValue, 0, max)
            value = newValue
            local percent = (value / max)
            
            PercentLabel.Text = math.floor(percent * 100) .. "%"
            Tween(ProgressFill, 0.5, {Size = UDim2.new(percent, 0, 1, 0)}, Enum.EasingStyle.Quart)
            
            -- Pulse effect on update
            Tween(PercentLabel, 0.15, {TextSize = 17}, Enum.EasingStyle.Quart)
            task.wait(0.15)
            Tween(PercentLabel, 0.15, {TextSize = 15}, Enum.EasingStyle.Quart)
        end
        
        table.insert(page.Elements, Container)
        return ProgressBar
    end
    
