            })
            AddCorner(DropdownList, 8)
            AddStroke(DropdownList, Theme.Border, 1, 0.3)
            
            local ListLayout = Create("UIListLayout", {
                Parent = DropdownList,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
            })
            AddPadding(DropdownList, 5)
            
            local dropdownOpen = false
            
            DropdownButton.MouseButton1Click:Connect(function()
                dropdownOpen = not dropdownOpen
                DropdownList.Visible = dropdownOpen
                
                if dropdownOpen then
                    Tween(Arrow, 0.2, {Rotation = 180})
                    Tween(DropdownList, 0.2, {Size = UDim2.new(0.5, -20, 0, math.min(#options * 35 + 10, 200))})
                else
                    Tween(Arrow, 0.2, {Rotation = 0})
                    Tween(DropdownList, 0.2, {Size = UDim2.new(0.5, -20, 0, 0)})
                end
            end)
            
            for _, option in ipairs(options) do
                local OptionButton = Create("TextButton", {
                    Parent = DropdownList,
                    Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = Theme.Surface,
                    Text = "  " .. option,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
