        function Tab:AddSlider(text, min, max, default, callback)
            local SliderContainer = Create("Frame", {
                Parent = PageContainer,
                Size = UDim2.new(1, 0, 0, 65),
                BackgroundColor3 = Theme.Card,
                LayoutOrder = #self.Elements + 1,
            })
            AddCorner(SliderContainer, 10)
            AddStroke(SliderContainer, Theme.Border, 1, 0.3)
            
            local Label = Create("TextLabel", {
                Parent = SliderContainer,
                Position = UDim2.new(0, 15, 0, 10),
                Size = UDim2.new(1, -80, 0, 18),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = Theme.Text,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            
            local ValueLabel = Create("TextLabel", {
                Parent = SliderContainer,
                Position = UDim2.new(1, -15, 0, 10),
                AnchorPoint = Vector2.new(1, 0),
                Size = UDim2.new(0, 60, 0, 18),
                BackgroundTransparency = 1,
                Text = tostring(default or min),
                TextColor3 = Theme.Primary,
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right,
            })
            
            local SliderTrack = Create("Frame", {
                Parent = SliderContainer,
                Position = UDim2.new(0, 15, 1, -20),
                Size = UDim2.new(1, -30, 0, 6),
                BackgroundColor3 = Theme.Surface,
            })
            AddCorner(SliderTrack, 10)
            
            local SliderFill = Create("Frame", {
                Parent = SliderTrack,
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = Theme.Primary,
            })
            AddCorner(SliderFill, 10)
            
            local SliderButton = Create("Frame", {
                Parent = SliderTrack,
                Position = UDim2.new(0, 0, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = Theme.Primary,
            })
            AddCorner(SliderButton, 20)
            AddStroke(SliderButton, Color3.fromRGB(255, 255, 255), 3, 0)
            
            local value = default or min
            local dragging = false
            
            local function UpdateSlider(inputPos)
                local relativePos = math.clamp((inputPos - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * relativePos)
                ValueLabel.Text = tostring(value)
                
                Tween(SliderFill, 0.1, {Size = UDim2.new(relativePos, 0, 1, 0)})
                Tween(SliderButton, 0.1, {Position = UDim2.new(relativePos, 0, 0.5, 0)})
                
                if callback then
                    callback(value)
                end
            end
            
            -- Initialize
            UpdateSlider(SliderTrack.AbsolutePosition.X + (SliderTrack.AbsoluteSize.X * ((value - min) / (max - min))))
            
            SliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    UpdateSlider(input.Position.X)
                    Tween(SliderButton, 0.15, {Size = UDim2.fromOffset(20, 20)})
                end
            end)
            
            SliderTrack.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                    Tween(SliderButton, 0.15, {Size = UDim2.fromOffset(16, 16)})
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(input.Position.X)
                end
            end)
            
            table.insert(self.Elements, SliderContainer)
            
            return {
                Container = SliderContainer,
                SetValue = function(newValue)
                    value = math.clamp(newValue, min, max)
                    UpdateSlider(SliderTrack.AbsolutePosition.X + (SliderTrack.AbsoluteSize.X * ((value - min) / (max - min))))
                end,
                GetValue = function()
                    return value
                end
            }
        end
        
